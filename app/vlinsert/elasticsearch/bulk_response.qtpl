{% stripspace %}

{% func BulkResponse(results bulkItemResult, tookMs int64) %}
{
	"took":{%dl tookMs %},
	"errors":{% if hasBulkErrors(results) %}true{% else %}false{% endif %},
	"items":[
		{% for i, err := range results %}
		{
			"create":{
				{% if err != nil %}
				"status":413
				,"error":{
					"reason":{%q= err.Error() %}
				}
				{% else %}
				"status":201
				{% endif %}
			}
		}
		{% if i+1 < len(results) %},{% endif %}
		{% endfor %}
	]
}
{% endfunc %}

{% endstripspace %}
