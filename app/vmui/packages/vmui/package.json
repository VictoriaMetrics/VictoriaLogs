{
  "name": "vmui",
  "version": "0.1.0",
  "private": true,
  "homepage": "./",
  "type": "module",
  "scripts": {
    "prestart": "npm run gen:logsql-pipes",
    "start": "vite",
    "start:playground": "cross-env PLAYGROUND=LOGS npm run start",
    "build": "vite build",
    "lint": "eslint --format stylish 'src/**/*.{ts,tsx}'",
    "lint:local": "eslint --ext .ts,.tsx -f stylish src",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "gen:logsql-pipes": "tsx --tsconfig scripts/tsconfig.json scripts/extractPipes.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dev": "vitest",
    "precommit": "npm run lint:local && npm run typecheck && npm run test"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "lodash.debounce": "^4.0.8",
    "lodash.throttle": "^4.1.1",
    "marked": "^18.1.3",
    "preact": "^10.29.7",
    "qs": "^6.17.1",
    "react-input-mask": "^2.0.4",
    "react-router-dom": "^7.18.5",
    "uplot": "^1.6.32",
    "vite": "^8.3.6",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.2",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.6",
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^26.6.6",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.3.0",
    "@types/react-input-mask": "^3.0.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "sass-embedded": "^1.108.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
