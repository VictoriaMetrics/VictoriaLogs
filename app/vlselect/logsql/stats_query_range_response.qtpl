{% stripspace %}

// StatsQueryRangeResponse generates response for /select/logsql/stats_query_range
{% func StatsQueryRangeResponse(rows []*statsSeries) %}
{
	"status":"success",
	"data":{
		"resultType":"matrix",
		"result":[
			{% code var hss histogramSeriesSplitter %}
			{% for i, ss := range rows %}
				{% if i > 0 %},{% endif %}
				{% if ss.isHistogram %}
					{% for j, bs := range hss.split(ss.Points) %}
						{% if j > 0 %},{% endif %}
						{%= formatStatsHistogramBucketSeries(ss, &bs) %}
					{% endfor %}
				{% else %}
					{%= formatStatsSeries(ss) %}
				{% endif %}
			{% endfor %}
		]
	}
}
{% endfunc %}

{% func formatStatsSeries(ss *statsSeries) %}
{
	"metric":{
		"__name__":{%q= ss.Name %}
		{%s= ss.Labels %}
	},
	"values":[
		{% for i := range ss.Points %}
			{% if i > 0 %},{% endif %}
			{%= formatStatsPoint(&ss.Points[i]) %}
		{% endfor %}
	]
}
{% endfunc %}

{% func formatStatsPoint(p *statsPoint) %}
[
	{%f= float64(p.Timestamp)/1e9 %},
	{%q= p.Value %}
]
{% endfunc %}

{% func formatStatsHistogramBucketSeries(ss *statsSeries, bs *histogramBucketSeries) %}
{
	"metric":{
		"__name__":{%q= ss.Name %}
		{%s= ss.Labels %}
		,"vmrange":{%q= bs.VMRange %}
	},
	"values":[
		{% for i := range bs.Points %}
			{% if i > 0 %},{% endif %}
			[
				{%f= float64(bs.Points[i].Timestamp)/1e9 %},
				"{%dul= bs.Points[i].Hits %}"
			]
		{% endfor %}
	]
}
{% endfunc %}

{% endstripspace %}
