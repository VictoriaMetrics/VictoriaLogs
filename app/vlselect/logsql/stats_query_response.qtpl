{% stripspace %}

// StatsQueryResponse generates response for /select/logsql/stats_query
{% func StatsQueryResponse(rows []statsRow) %}
{
	"status":"success",
	"data":{
		"resultType":"vector",
		"result":[
			{% code var buckets []histogramBucket %}
			{% for i := range rows %}
				{% if i > 0 %},{% endif %}
				{% code r := &rows[i] %}
				{% if r.isHistogram %}
					{% code buckets, _ = appendHistogramBuckets(buckets[:0], r.Value) %}
					{% for j := range buckets %}
						{% if j > 0 %},{% endif %}
						{%= formatStatsHistogramBucketRow(r, &buckets[j]) %}
					{% endfor %}
				{% else %}
					{%= formatStatsRow(r) %}
				{% endif %}
			{% endfor %}
		]
	}
}
{% endfunc %}

{% func formatStatsRow(r *statsRow) %}
{
	"metric":{
		"__name__":{%q= r.Name %}
		{%s= r.Labels %}
	},
	"value":[{%f= float64(r.Timestamp)/1e9 %},{%q= r.Value %}]
}
{% endfunc %}

{% func formatStatsHistogramBucketRow(r *statsRow, b *histogramBucket) %}
{
	"metric":{
		"__name__":{%q= r.Name %}
		{%s= r.Labels %}
		,"vmrange":{%q= b.VMRange %}
	},
	"value":[{%f= float64(r.Timestamp)/1e9 %},"{%dul= b.Hits %}"]
}
{% endfunc %}

{% endstripspace %}
