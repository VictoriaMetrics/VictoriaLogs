{% stripspace %}

// StatsQueryResponse generates response for /select/logsql/stats_query
{% func StatsQueryResponse(shards []*[]statsRow) %}
{
	"status":"success",
	"data":{
		"resultType":"vector",
		"result":[
			{% code isFirst := true %}
			{% for _, rows := range shards %}
				{% for i := range *rows %}
					{% if !isFirst %},{% endif %}
					{% code isFirst = false %}
					{%= formatStatsRow(&(*rows)[i]) %}
				{% endfor %}
			{% endfor %}
		]
	}
}
{% endfunc %}

{% func formatStatsRow(r *statsRow) %}
{
	"metric":{
		"__name__":{%q= r.Name %}
		{% if len(r.Labels) > 0 %}
			{% for _, label := range r.Labels %}
				,{%q= label.Name %}:{%q= label.Value %}
			{% endfor %}
		{% endif %}
	},
	"value":[{%f= float64(r.Timestamp)/1e9 %},{%q= r.Value %}]
}
{% endfunc %}

{% endstripspace %}
