{% stripspace %}

// StatsQueryResponse generates response for /select/logsql/stats_query
{% func StatsQueryResponse(shards []*[]statsRow) %}
{
	"status":"success",
	"data":{
		"resultType":"vector",
		"result":[
			{% code
				isFirst := true
				var buckets []histogramBucket
			%}
			{% for _, rows := range shards %}
				{% for i := range *rows %}
					{% if !isFirst %},{% endif %}
					{% code
						isFirst = false
						r := &(*rows)[i]
					%}
					{% if r.isHistogram %}
						{% code buckets, _ = appendHistogramBuckets(buckets[:0], r.Value) %}
						{% for j := range buckets %}
							{% if j > 0 %},{% endif %}
							{%= formatStatsHistogramBucketRow(r, &buckets[j]) %}
						{% endfor %}
					{% else %}
						{%= formatStatsRow(r) %}
					{% endif %}
				{% endfor %}
			{% endfor %}
		]
	}
}
{% endfunc %}

{% func formatStatsRow(r *statsRow) %}
{
	"metric":{
		"__name__":{%q= r.Name %}
		{%s= r.Labels %}
	},
	"value":[{%f= float64(r.Timestamp)/1e9 %},{%q= r.Value %}]
}
{% endfunc %}

{% func formatStatsHistogramBucketRow(r *statsRow, b *histogramBucket) %}
{
	"metric":{
		"__name__":{%q= r.Name %}
		{%s= r.Labels %}
		,"vmrange":{%q= b.VMRange %}
	},
	"value":[{%f= float64(r.Timestamp)/1e9 %},"{%dul= b.Hits %}"]
}
{% endfunc %}

{% endstripspace %}
